# Copy this file to .env and add your own key. Never commit .env.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DeepSeek Flash supports photo-based composition recognition and review.
DEEPSEEK_MODEL=deepseek-flash
# Optional: keep the official endpoint unless you use a compatible gateway.
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Aliyun will usually inject PORT. HOST=0.0.0.0 accepts external traffic behind a proxy.
PORT=4173
HOST=0.0.0.0
